{
  "_comment": "PPO + chess-engine2（Windows 环境机）。先启动环境服务：python -m tools.net_service --auto blue --port 8000 --host 0.0.0.0；再在 WSL 跑 rl-train。io 必须与服务端 --max-actions/--obs-entities 一致。",
  "meta": {"name": "ppo_chess"},
  "env": {
    "type": "chess_remote",
    "url": "http://127.0.0.1:8000",
    "config": {"side": "red", "max_entities": 12, "timeout": 15.0},
    "action_space_type": "discrete",
    "action_dim": 32,
    "io": {
      "obs": {
        "shape": [12, 10],
        "dim": 10,
        "entity_set": true,
        "names": ["dx", "dy", "hp_ratio", "atk_ratio", "armor",
                  "move_ratio", "is_enemy", "is_self", "alive", "tick_ratio"],
        "normalize": true
      },
      "action": {"space_type": "discrete", "dim": 32}
    }
  },
  "networks": {
    "policy": {
      "network_stack": [
        {"type": "mlp", "config": {"in_dim": 10, "hidden_dims": [128, 128], "out_dim": 128, "activation": "ReLU"}}
      ],
      "head": "actor_critic"
    }
  },
  "algo": {
    "name": "ppo",
    "config": {
      "device": "cpu", "action_dim": 32,
      "learning_rate": 3e-4, "gamma": 0.99, "gae_lambda": 0.95,
      "clip_coef": 0.2, "ent_coef": 0.01, "vf_coef": 0.5, "max_grad_norm": 0.5
    }
  },
  "train": {
    "seed": 42, "total_epochs": 20, "rollout_steps": 512,
    "update_epochs": 4, "minibatch_size": 128, "eval_interval": 5
  }
}